[gd_scene load_steps=2 format=3 uid="uid://du3jwd3145ubg"]

[sub_resource type="GDScript" id="GDScript_xpls8"]
script/source = "extends Control
signal node_chosen(room_type: String)
signal request_next_choices

var _area_id := 1
var _tiers := 6
var _fixed_tail: Array[String] = []
var _choices_this_tier: Array[String] = []

@onready var b1: Button = $VBoxContainer/Button1
@onready var b2: Button = $VBoxContainer/Button2
@onready var b3: Button = $VBoxContainer/Button3

func setup_for_area(area_id:int, tiers:int, fixed_tail:Array) -> void:
	_area_id = area_id
	_tiers = tiers
	_fixed_tail = fixed_tail

func show_choices_for_tier(tier_index:int) -> void:
	var tail_start := _tiers
	if tier_index >= tail_start:
		var idx := tier_index - tail_start
		if idx >= 0 and idx < _fixed_tail.size():
			_choices_this_tier = [_fixed_tail[idx]]
		else:
			_choices_this_tier = []
	else:
		_choices_this_tier = _get_weighted_choices(_area_id, 3)

	# apply to buttons (hide unused)
	var buttons := [b1,b2,b3]
	for i in buttons.size():
		if i < _choices_this_tier.size():
			var t := _choices_this_tier[i]
			buttons[i].text = t.capitalize()
			buttons[i].visible = true
			buttons[i].disconnect(\"pressed\", Callable(self, \"_on_pick\")) if buttons[i].is_connected(\"pressed\", Callable(self, \"_on_pick\")) else null
			buttons[i].pressed.connect(_on_pick.bind(t))
		else:
			buttons[i].visible = false

func _on_pick(room_type:String) -> void:
	emit_signal(\"node_chosen\", room_type)

func _get_weighted_choices(area_id:int, n:int) -> Array[String]:
	var weights:Dictionary = AreaDB.areas[area_id][\"map_weights\"]
	var pool: Array[String] = []
	for k in weights.keys():
		for i in range(int(weights[k])):
			pool.append(str(k))
	var out: Array[String] = []
	while out.size() < n and pool.size() > 0:
		var pick := pool[randi() % pool.size()]
		if not out.has(pick):
			out.append(pick)
		pool.erase(pick)
	return out
"

[node name="MapScreen" type="Node2D"]
script = SubResource("GDScript_xpls8")
